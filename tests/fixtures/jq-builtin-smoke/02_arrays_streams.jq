{
  add: ([1,2,3] | add),
  min: ([3,1,2] | min),
  max: ([3,1,2] | max),
  min_by: ([{x:2},{x:1}] | min_by(.x)),
  max_by: ([{x:2},{x:1}] | max_by(.x)),
  sort: ([3,1,2,1] | sort),
  sort_by: ([{x:2},{x:1}] | sort_by(.x)),
  group_by: ([3,1,2,1] | group_by(.)),
  unique: ([3,1,2,1] | unique),
  unique_by: ([{x:1},{x:2},{x:1}] | unique_by(.x)),
  reverse: ([1,2,3] | reverse),
  flatten: ([[1,[2]],3] | flatten),
  flatten_n: ([[1,[2]],3] | flatten(1)),
  transpose: ([[1,2],[3,4]] | transpose),
  first: ([10,20,30] | first),
  first_gen: (first(1,2,3)),
  last: ([10,20,30] | last),
  last_gen: (last(1,2,3)),
  nth: ([10,20,30] | nth(1)),
  nth_gen: (nth(1; 10,20,30)),
  limit: ([limit(2; range(10))]),
  range1: ([range(3)]),
  range2: ([range(1;4)]),
  range3: ([range(1;6;2)]),
  combinations: ([[1,2],["a","b"]] | [combinations]),
  combinations_n: ([1,2] | [combinations(2)]),
  bsearch: ([1,3,5,7] | bsearch(5))
}
