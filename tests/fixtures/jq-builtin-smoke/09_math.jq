{
  abs: (-2 | abs),
  floor: (1.9 | floor),
  ceil: (1.1 | ceil),
  round: (1.5 | round),
  trunc: (-1.9 | trunc),
  sqrt: (9 | sqrt),
  cbrt: (8 | cbrt),
  exp: (1 | exp),
  exp2: (3 | exp2),
  exp10: (2 | exp10),
  expm1: (1 | expm1),
  log: (2 | log),
  log2: (8 | log2),
  log10: (100 | log10),
  log1p: (1 | log1p),
  sin: (0.5 | sin),
  cos: (0.5 | cos),
  tan: (0.5 | tan),
  asin: (0.5 | asin),
  acos: (0.5 | acos),
  atan: (0.5 | atan),
  sinh: (0.5 | sinh),
  cosh: (0.5 | cosh),
  tanh: (0.5 | tanh),
  asinh: (0.5 | asinh),
  acosh: (2 | acosh),
  atanh: (0.5 | atanh),
  atan2: (atan2(1; 1)),
  hypot: (hypot(3; 4)),
  pow: (pow(2; 8)),
  fmod: (fmod(7; 3)),
  remainder: (remainder(7; 3)),
  copysign: (copysign(1; -2)),
  fdim: (fdim(5; 3)),
  fmax: (fmax(2; 3)),
  fmin: (fmin(2; 3)),
  fma: (fma(2; 3; 4)),
  frexp: (8 | frexp),
  ldexp: (ldexp(0.5; 4)),
  modf: (1.5 | modf),
  isfinite: (1 | isfinite),
  isinfinite: (infinite | isinfinite),
  isnan: (nan | isnan),
  isnormal: (1 | isnormal),
  infinite: (infinite | type),
  nan: (nan | isnan)
}
